<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cyberwarfare & Surveillance Exports Dashboard</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
  <script src="https://cdn.plot.ly/plotly-2.35.2.min.js" defer></script>
  <script defer>
    async function loadCSV() {
      const res = await fetch("{{ url_for('static', filename='data/surveillance_exports.csv') }}");
      const text = await res.text();
      // Simple CSV parse (no quoted commas in this sample)
      const rows = text.trim().split('\n').map(r => r.split(','));
      const header = rows[0];
      const data = rows.slice(1);
      const idx = Object.fromEntries(header.map((h,i)=>[h,i]));

      // Build counts for bar chart (Origin_Group -> counts)
      const counts = {};
      data.forEach(r => {
        const origin = r[idx['Supplier_Region']];
        counts[origin] = (counts[origin]||0)+1;
      });
      const barX = Object.keys(counts);
      const barY = barX.map(k => counts[k]);

      Plotly.newPlot('chart-origin', [{
          type:'bar', x: barX, y: barY
        }], {
          title:'Exports by Origin Region',
          paper_bgcolor:'#151515', plot_bgcolor:'#151515',
          font:{color:'#f5f5f5'}
        });

      // Timeline: count by year
      const yearCounts = {};
      data.forEach(r => {
        const yr = r[idx['Year']];
        yearCounts[yr] = (yearCounts[yr]||0)+1;
      });
      const years = Object.keys(yearCounts).sort();
      const vals = years.map(y => yearCounts[y]);

      Plotly.newPlot('chart-timeline', [{
          type:'scatter', mode:'lines+markers', x: years, y: vals
        }], {
          title:'Deals Over Time',
          paper_bgcolor:'#151515', plot_bgcolor:'#151515',
          font:{color:'#f5f5f5'}
        });

      // Sankey-like pairs (Supplier -> Buyer)
      const links = data.map(r => ({
        supplier: r[idx['Supplier']],
        buyer: r[idx['Buyer']]
      }));
      const suppliers = [...new Set(links.map(l=>l.supplier))];
      const buyers = [...new Set(links.map(l=>l.buyer))];
      const nodes = suppliers.concat(buyers);
      const nodeIndex = Object.fromEntries(nodes.map((n,i)=>[n,i]));

      const linkCounts = {};
      links.forEach(l => {
        const key = l.supplier + '->' + l.buyer;
        linkCounts[key] = (linkCounts[key]||0)+1;
      });
      const sankeyLinks = Object.entries(linkCounts).map(([k,v])=>{
        const [s,b] = k.split('->');
        return {source: nodeIndex[s], target: nodeIndex[b], value: v};
      });

      Plotly.newPlot('chart-network', [{
        type: 'sankey',
        orientation: 'h',
        node: {
          pad: 15, thickness: 18,
          label: nodes,
          color: nodes.map(()=> '#00bfa5')
        },
        link: {
          source: sankeyLinks.map(l=>l.source),
          target: sankeyLinks.map(l=>l.target),
          value: sankeyLinks.map(l=>l.value)
        }
      }], {
        title:'Supplier → Buyer Flows (sample)',
        paper_bgcolor:'#151515', plot_bgcolor:'#151515',
        font:{color:'#f5f5f5'}
      });
    }
    window.addEventListener('DOMContentLoaded', loadCSV);
  </script>
</head>
<body>
<header>
  <h1>Surveillance Exports Dashboard</h1>
  <nav>
    <a href="/">Home</a>
    <a href="/dashboard">Dashboard</a>
    <a href="/automation">Automation</a>
  </nav>
</header>
<div class="container">
  <p class="small">Sample data for demonstration. Replace <code>/static/data/surveillance_exports.csv</code> with your n8n-fed dataset.</p>
  <div id="chart-origin" class="chart"></div>
  <div id="chart-timeline" class="chart"></div>
  <div id="chart-network" class="chart"></div>
</div>
<footer>
  <p>© 2025 Duncan Lawrence | Smoking Mirror LLC</p>
</footer>
</body>
</html>
